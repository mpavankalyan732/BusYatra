# ---------- Core ----------
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/busyatra?schema=public
JWT_SECRET=
FRONTEND_URL=http://localhost:5173
# Comma-separated extra CORS origins (optional)
CORS_ORIGINS=

# ---------- Booking rules ----------
SEAT_LOCK_MINUTES=10
TAX_RATE=0.05
CONVENIENCE_FEE_PER_SEAT=25
RESCHEDULE_CUTOFF_HOURS=24
RESCHEDULE_FEE_PER_SEAT=50
MAX_RESCHEDULES=2

# ---------- Email (SMTP via Nodemailer) ----------
# Leave SMTP_HOST empty in development: emails are rendered to the log instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BusYatra <no-reply@busyatra.dev>"

# ---------- Salesforce CRM (OAuth 2.0 client credentials) ----------
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_INSTANCE_URL=https://YOUR-DOMAIN.develop.my.salesforce.com
SALESFORCE_TOKEN_URL=https://YOUR-DOMAIN.develop.my.salesforce.com/services/oauth2/token
SALESFORCE_API_VERSION=v61.0

# ---------- Agentforce (Agent API) ----------
# JSON: {"agentId":"0Xx...","myDomainUrl":"https://your-domain.my.salesforce.com","clientId":"...","clientSecret":"...","apiBaseUrl":"https://api.salesforce.com/einstein/ai-agent/v1"}
# clientId/clientSecret default to the SALESFORCE_* values. Leave empty to use the clearly-labelled MOCK agent.
AGENTFORCE_CONFIGURATION=
# Shared secret Salesforce (Apex via Named Credential) sends in x-agent-api-key when calling /api/agent-actions/*
AGENT_ACTION_API_KEY=

