{
  "name": "busyatra-backend",
  "version": "1.0.0",
  "private": true,
  "description": "BusYatra bus booking API (Express + Prisma + PostgreSQL)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "build": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "seed": "node prisma/seed.js",
    "test": "node --test tests/*.test.js",
    "start:render": "prisma migrate deploy && node prisma/seed.js && node src/server.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.2",
    "express-rate-limit": "7.4.1",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "nodemailer": "6.9.16",
    "pdfkit": "0.15.1",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "qrcode": "1.5.4",
    "zod": "3.23.8",
    "prisma": "6.16.2"
  },
  "devDependencies": {
    "pino-pretty": "13.0.0"
  }
}
